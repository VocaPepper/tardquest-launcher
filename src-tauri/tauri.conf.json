{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TQ Launcher",
  "version": "2.0.2608",
  "identifier": "online.tardquest.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TQ Launcher",
        "width": 1140,
        "height": 760,
        "resizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/VocaPepper/tardquest-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGOTAwODFBM0VBREU3MwpSV1J6M3VxamdRRDVBMWNKMll0b3p5dWIwelR4Y20zcEhMdTNjZlBjTEo2bGVzaWJ6dm1rTWRtVAo="
    }
  }
}
